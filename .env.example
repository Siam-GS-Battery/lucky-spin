# Copy to .env and fill in real values. Never commit .env.
# In production (NODE_ENV=production) every secret below is required; the server refuses to start otherwise.

# --- Runtime ---
# development | test | production (the Docker image sets production)
NODE_ENV=development
# Bind address. 127.0.0.1 for local dev; the Docker image sets 0.0.0.0
HOST=127.0.0.1
# HTTP port (Railway injects its own PORT)
PORT=8787
# Absolute path to the built frontend (Vite dist). Default: ../frontend/dist relative to backend/
FRONTEND_DIST=

# --- Google Sheet via Apps Script ---
# Apps Script Web App URL (Deploy > Web app > /exec). Must start with https://script.google.com/
SCRIPT_GOOGLE_SHEET=
# Same value as Script Property TOKEN in Apps Script (Project Settings > Script Properties)
SCRIPT_TOKEN=

# --- Booth login ---
# Shared booth staff credentials for the login page
APP_USERNAME=
APP_PASSWORD=

# --- Session ---
# Signs the 4 h session JWT. Min 32 characters in production, e.g. `openssl rand -hex 32`
JWT_SECRET=

# --- Admin panel ---
# PIN that unlocks admin actions (4 to 8 digits)
ADMIN_PIN=
