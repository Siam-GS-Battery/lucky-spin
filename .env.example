# Apps Script Web App URL (Deploy › Web app › /exec)
SCRIPT_GOOGLE_SHEET=https://script.google.com/macros/s/XXXX/exec
# Same value as Script Property TOKEN in Apps Script (Project Settings › Script Properties)
SCRIPT_TOKEN=
# Login page before the app. Leave APP_PASSWORD empty to turn login off (local only). Set all three on Railway.
APP_USERNAME=booth
APP_PASSWORD=
# Signs the 4 h session JWT. Long random value, e.g. `openssl rand -hex 32`. Without it sessions reset on restart.
JWT_SECRET=
